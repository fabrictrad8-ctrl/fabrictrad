NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Privileged server key used by trusted marketplace administration APIs.
# Authentication email OTP and password recovery do not depend on this key.
SUPABASE_SECRET_KEY=sb_secret_replace_with_server_only_key
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Server-only administrator identity.
ADMIN_EMAIL=fabrictrad8@gmail.com
ADMIN_PASSWORD=replace-with-a-unique-password-manager-generated-password
ADMIN_FULL_NAME=FabricTrad Administrator
ADMIN_ROLE=super_admin

# Authentication email is configured directly in Supabase Dashboard:
# Authentication → SMTP Settings
# Host: smtp.resend.com
# Port: 465
# Username: resend
# Password: existing Resend API key
# Sender: FabricTrad <auth@fabrictrad.com>

# Transactional invoice email. The production Resend domain is fabrictrad.com.
# If RESEND_API_KEY is absent, the invoice service can also reuse SMTP_PASSWORD
# when that value is an existing Resend API key (re_...).
RESEND_API_KEY=
SMTP_PASSWORD=
INVOICE_FROM_EMAIL=billing@fabrictrad.com
INVOICE_REPLY_TO=support@fabrictrad.com

# One server-side OpenAI key powers structured catalogue extraction and AI Drape-On.
OPENAI_API_KEY=
OPENAI_CATALOG_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
ALLOWED_OPEN_AI_MODELS=gpt-4o-mini,gpt-4.1-mini
ALLOWED_ANTHROPIC_MODELS=claude-3-5-haiku-latest,claude-3-7-sonnet-latest
ALLOWED_GEMINI_MODELS=gemini/gemini-2.0-flash,gemini/gemini-2.5-flash
ALLOWED_PERPLEXITY_MODELS=sonar,sonar-pro
AI_CHAT_DAILY_LIMIT=100

OPENAI_DRAPE_IMAGE_MODEL=gpt-image-2
OPENAI_DRAPE_IMAGE_SIZE=1024x1536
OPENAI_DRAPE_IMAGE_QUALITY=medium
GEMINI_DRAPE_IMAGE_MODEL=gemini/gemini-2.5-flash-image
GEMINI_DRAPE_IMAGE_SIZE=1024x1536
AI_DRAPE_DAILY_LIMIT=10
AI_DRAPE_FALLBACK_DAILY_LIMIT=3
AI_DRAPE_COOKIE_SECRET=
AI_IMAGE_SOURCE_HOSTS=

GSTIN_VERIFICATION_API_URL=
GSTIN_VERIFICATION_API_KEY=
GSTIN_VERIFICATION_API_METHOD=GET
GSTIN_VERIFICATION_API_KEY_HEADER=x-api-key
GSTIN_VERIFICATION_PROVIDER_NAME=

# Razorpay Standard Checkout. Keep both values server-only.
# The authenticated create-order endpoint returns only the public Key ID to Checkout,
# so NEXT_PUBLIC_RAZORPAY_KEY_ID is intentionally not required.
# Use matching Test Mode credentials during testing and matching Live Mode credentials at launch.
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_server_only_key_secret
# Configure this separately in Razorpay Dashboard for /api/razorpay/webhook.
RAZORPAY_WEBHOOK_SECRET=replace_with_a_unique_webhook_secret
PLATFORM_COMMISSION_RATE=0.10
PLATFORM_COMMISSION_GST_RATE=0.18
RAZORPAY_PROCESSING_RATE=0.02

# WhatsApp through Gupshup. Keep provider credentials server-only.
# Configure the Gupshup callback as Meta-format v3 (v2 remains supported):
# https://fabrictrad.com/api/integrations/whatsapp/webhook
NEXT_PUBLIC_WHATSAPP_BUSINESS_NUMBER=917977286898
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=Fabrictrad
GUPSHUP_SOURCE_NUMBER=917977286898
# Optional identity checks. Add these when shown in the Gupshup application.
GUPSHUP_APP_ID=
GUPSHUP_WABA_ID=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Gupshup names for approved Meta utility templates used by the five-minute
# scheduler whenever the customer-service window is closed. Expected body
# variables are documented in src/lib/bespokeFollowUps.ts in the exact parameter
# order sent by each job.
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=
WHATSAPP_TEMPLATE_PAYMENT_REMINDER=
WHATSAPP_TEMPLATE_TRIAL_REMINDER=
WHATSAPP_TEMPLATE_DELIVERY_UPDATE=
WHATSAPP_TEMPLATE_REVIEW_REQUEST=
WHATSAPP_TEMPLATE_POST_DELIVERY_FOLLOW_UP=

SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
DEFAULT_SHIPMENT_LENGTH_CM=10
DEFAULT_SHIPMENT_BREADTH_CM=10
DEFAULT_SHIPMENT_HEIGHT_CM=10
DEFAULT_SHIPMENT_WEIGHT_KG=0.5

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
